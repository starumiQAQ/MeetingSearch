# Web 服务 key — server-side geocode / POI / driving Distance
AMAP_KEY=
# 高德 Web 服务 QPS 上限（次/秒）。个人 key 常见为 3；超限会 CUQPS_HAS_EXCEEDED_THE_LIMIT。
AMAP_QPS=3

# Web 端 (JS API) key — browser map display. Falls back to AMAP_KEY if unset.
# Prefer a dedicated JS-platform key with domain whitelist in the 高德 console.
AMAP_JS_KEY=
# Required for JS API keys created after 2021-12-02 (securityJsCode).
AMAP_SECURITY_JS_CODE=
